          }
        }
      }
    },
    "/api/customers/me": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Отримати дані профілю поточного користувача за його JWT токеном.",
        "responses": {
          "200": {
            "description": "Профіль успішно знайдено та розпарсено з токена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Користувача не знайдено або токен недійсний",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
